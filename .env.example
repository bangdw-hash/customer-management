# ===== 백엔드 연동용 환경변수 (Vercel → Settings → Environment Variables) =====

# 1) 데이터베이스 (Neon/Supabase 등 무료 Postgres 연결 문자열)
#    미설정 시 앱은 자동으로 "데모(목업)" 모드로 동작합니다.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# 2) AI 리포트 생성 (Anthropic API Key) — 미설정 시 템플릿으로 자동 폴백
ANTHROPIC_API_KEY="sk-ant-..."

# 3) 초기 데이터 주입(seed) 보호 토큰 (임의 문자열)
SEED_TOKEN="change-me-please"

# 5) 사진 영구저장 (Vercel Blob) — Vercel에서 Blob 스토어 생성 시 자동 주입됨
#    (없으면 사진은 촬영·미리보기만, 저장은 생략)
BLOB_READ_WRITE_TOKEN=""

# 4) 메시지 발송 — Solapi
#    [SMS만 사용] 사업자 없이 가능. 아래 3개만 넣으면 즉시 문자 발송.
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_SENDER=""        # 등록된 발신번호 (처제 번호, 예: 01012345678)
#    [알림톡 추가] 사업자+채널 승인 후, 아래 + 템플릿ID 추가 시 알림톡 발송
SOLAPI_PFID=""          # 카카오 채널 발신프로필 ID (알림톡용, SMS는 불필요)
# 알림톡 승인 템플릿 ID들 (선택)
# (대안) 발송대행사 대신 Make/자체서버 웹훅을 쓰려면 아래 사용
MESSAGE_WEBHOOK_URL=""
MESSAGE_API_KEY=""

# 5) 캘린더 연동(구글/네이버) 웹훅 — 미설정 시 .ics 생성만(항상 동작)
CALENDAR_WEBHOOK_URL=""
